# Server
PORT=5000
NODE_ENV=development

# MongoDB: local install, or a MongoDB Atlas connection string (never commit the real one)
MONGO_URI=mongodb://127.0.0.1:27017/mentra

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Only needed if the frontend is served from a different origin
CLIENT_ORIGIN=

# Optional Python matching module (see ai/README.md). Leave false to use the built-in keyword engine.
AI_ENABLED=false
PYTHON_BIN=python3
